APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
# Khóa mã hóa PHI cấp độ cột — nên là chuỗi random khác SECRET_KEY (trống sẽ dùng SECRET_KEY như fallback)
PHI_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://telemedicine:change-me@db:5432/telemedicine
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
# Chỉ bật seed tài khoản demo khi chạy local. Production sẽ fail-fast nếu SEED_DEMO=true.
SEED_DEMO=false

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-change-me

HIS_ADAPTER=mock
# Mock HIS Server (mock_his/): đổi HIS_ADAPTER=http và trỏ tới server
# - Trong docker compose: http://mock-his:8100
# - Chạy local ngoài docker: http://localhost:8100
HIS_BASE_URL=http://localhost:8100
HIS_API_KEY=his-dev-key-change-me
PACS_ADAPTER=mock
PAYMENT_PROVIDER=mock

# Coturn WebRTC TURN/STUN
COTURN_AUTH_SECRET=careconnect-turn-secret-change-me
COTURN_REALM=telemedicine.careconnect.local
COTURN_HOST=
COTURN_PORT=3478
COTURN_TLS_PORT=5349
COTURN_CREDENTIAL_TTL=600

# SMS / Zalo ZNS OTP Gateway (mock khi dev — mã OTP chỉ trả về dev_code ở môi trường dev)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRANDNAME=CARECONNECT

# PAYMENT_WEBHOOK_SECRET: cổng thanh toán phải ký HMAC-SHA256(raw body) vào header X-Signature
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
